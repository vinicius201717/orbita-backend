NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://orbita:orbita_local_only@localhost:54432/orbita?schema=public
REDIS_URL=redis://localhost:56379
CORS_ORIGINS=http://localhost:3001
# Explicit reverse-proxy IPs/CIDRs only; leave empty when directly exposed.
TRUST_PROXY_CIDRS=
# Isolated targets, validated before the integration runner or migration can execute.
TEST_DATABASE_URL=postgresql://orbita:orbita_local_only@localhost:54432/orbita_test?schema=public
TEST_REDIS_URL=redis://localhost:56379/1
JWT_SECRET=replace-with-random-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-different-random-at-least-32-characters
PIN_PEPPER=replace-with-different-random-at-least-32-characters
OUTBOX_ENCRYPTION_KEY=replace-with-64-hex-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_NOTIFICATION_TEMPLATE=
GOOGLE_MAPS_API_KEY=
MAPS_PROVIDER=mock
DYNAMIC_ROUTE_INSERTION_ENABLED=true
MULTI_PICKUP_ENABLED=true
REAL_PAYMENTS_ENABLED=false
OFFER_TTL_SECONDS=30
POOL_INTERVAL_SECONDS=10
GPS_TTL_SECONDS=90
GPS_HISTORY_SAMPLE_SECONDS=30
GPS_RETENTION_DAYS=7
DEFAULT_CAPACITY_UNITS=10
DEFAULT_PICKUP_SLA_SECONDS=1800
DEFAULT_DELIVERY_SLA_SECONDS=3600
DEFAULT_MAX_DELIVERY_SECONDS=2400
PIN_MAX_ATTEMPTS=5
PIN_PROXIMITY_METERS=0
MATCH_RADIUS_METERS=8000
MATCH_CANDIDATE_LIMIT=15
MATCH_EVALUATION_LIMIT=5
MAX_ROUTE_DELIVERIES=12
MAX_POOL_BATCH=50
BASE_REVENUE_CENTS=700
BASE_PAYOUT_CENTS=500
MIN_DRIVER_CENTS_PER_KM=150
MIN_DRIVER_CENTS_PER_HOUR=1500
MIN_PLATFORM_MARGIN_CENTS=0
WAIT_FREE_SECONDS=300
WAIT_FEE_CENTS_PER_MINUTE=50
PUBLIC_BASE_URL=http://localhost:3000
SEED_PASSWORD=replace-with-a-development-password
SCORE_ECONOMY_WEIGHT=1
SCORE_DRIVER_WEIGHT=1
SCORE_RELIABILITY_WEIGHT=1
SCORE_CAPACITY_WEIGHT=100
SCORE_SLA_WEIGHT=1
SCORE_DISTANCE_PENALTY=1
SCORE_TIME_PENALTY=1
SMART_POOL_WAIT_SECONDS=20
ECONOMY_POOL_WAIT_SECONDS=60
MOCK_SPEED_METERS_PER_SECOND=8
STOP_SERVICE_SECONDS=60
